{
  "name": "miscare",
  "version": "1.0.0",
  "description": "Mișcare — Aplicație PWA de exerciții de la 0, adaptivă, fără vinovăție și fără fricțiune",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "i18n": "node scripts/i18n-index.mjs && node scripts/i18n-check.mjs",
    "i18n:check": "node scripts/i18n-index.mjs && node scripts/i18n-check.mjs --check",
    "catalogue:sync": "node scripts/sync-client-catalogue.mjs",
    "android:assets": "node scripts/build-android.mjs",
    "android:sync": "npm run android:assets && cap sync android",
    "test:browser": "playwright test"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.6"
  },
  "overrides": {
    "@capacitor/cli": {
      "xcode": "^4.0.0"
    }
  }
}
